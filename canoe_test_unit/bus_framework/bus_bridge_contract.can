export long BusBridge_GetLastRxId()
{
  return gLastRxId;
}

export long BusBridge_GetLastRxExtended()
{
  return gLastRxExtended;
}

export long BusBridge_GetLastRxDlc()
{
  return gLastRxDlc;
}

export long BusBridge_GetLastRxByte(long index)
{
  if (index == 0) return gLastRxData0;
  if (index == 1) return gLastRxData1;
  if (index == 2) return gLastRxData2;
  if (index == 3) return gLastRxData3;
  if (index == 4) return gLastRxData4;
  if (index == 5) return gLastRxData5;
  if (index == 6) return gLastRxData6;
  if (index == 7) return gLastRxData7;
  return 0;
}

export long BusBridge_GetPeriodSampleCount()
{
  return gPeriodSampleCount;
}

export long BusBridge_GetPeriodAverageUs()
{
  return gPeriodAverageUs;
}

export long BusBridge_GetPeriodMinimumUs()
{
  return gPeriodMinimumUs;
}

export long BusBridge_GetPeriodMaximumUs()
{
  return gPeriodMaximumUs;
}

export long BusBridge_GetLastError()
{
  return gLastError;
}

